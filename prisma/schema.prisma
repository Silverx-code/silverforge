generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// USERS
// One user can own multiple stores (future-proofing),
// but MVP UX assumes one user -> one store during onboarding.
// ─────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stores Store[]

  @@map("users")
}

// ─────────────────────────────────────────────
// STORES
// The tenant boundary. Everything below belongs to a store.
// ─────────────────────────────────────────────
model Store {
  id              String   @id @default(cuid())
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name            String
  slug            String   @unique
  description     String?

  logo            String?
  primaryColor    String   @default("#111114")
  backgroundColor String   @default("#FAFAF8")
  font            String   @default("Inter")
  buttonStyle     ButtonStyle @default(ROUNDED)

  isPublished     Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sections Section[]
  products Product[]
  orders   Order[]

  @@map("stores")
}

enum ButtonStyle {
  ROUNDED
  SQUARE
  PILL
}

// ─────────────────────────────────────────────
// SECTIONS
// Homepage builder blocks (header, hero, featured products, promo, about, footer)
// ─────────────────────────────────────────────
model Section {
  id           String      @id @default(cuid())
  storeId      String
  store        Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  sectionType  SectionType
  content      Json        @default("{}")
  isVisible    Boolean     @default(true)
  sectionOrder Int         @default(0)

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([storeId, sectionType])
  @@index([storeId, sectionOrder])
  @@map("sections")
}

enum SectionType {
  HEADER
  HERO
  FEATURED_PRODUCTS
  PROMO_BANNER
  ABOUT
  FOOTER
}

// ─────────────────────────────────────────────
// PRODUCTS
// ─────────────────────────────────────────────
model Product {
  id          String      @id @default(cuid())
  storeId     String
  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name        String
  description String?
  price       Decimal     @db.Decimal(12, 2)
  image       String?
  stockStatus StockStatus @default(IN_STOCK)
  inventoryQuantity Int   @default(0)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  orderItems  OrderItem[]

  @@index([storeId])
  @@map("products")
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
}

// ─────────────────────────────────────────────
// ORDERS
// No payment gateway in the MVP — orders are submitted for the
// store owner to fulfill manually (cash on delivery / bank transfer, etc).
// ─────────────────────────────────────────────
model Order {
  id           String      @id @default(cuid())
  storeId      String
  store        Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  customerName String
  phone        String
  address      String

  status       OrderStatus @default(PENDING)
  total        Decimal     @db.Decimal(12, 2)

  items        OrderItem[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([storeId])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  FULFILLED
  CANCELLED
}

// Line items — lets an order reference multiple products with
// quantity + price-at-time-of-order captured for history.
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity  Int
  price     Decimal @db.Decimal(12, 2)

  @@map("order_items")
}
