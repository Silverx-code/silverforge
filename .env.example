# PostgreSQL connection strings
# For connection poolers (PgBouncer, Supabase Supavisor, Neon, AWS RDS Proxy),
# append `?pgbouncer=true&statement_cache_size=0` to disable prepared statement caching.
DATABASE_URL="postgresql://postgres:password@localhost:6543/silverforge?pgbouncer=true&statement_cache_size=0"

# Remote databases use TLS by default; localhost databases do not. Set
# DATABASE_SSL=true or DATABASE_SSL=false to override that choice.
# Set to true only when the remote database certificate is trusted by Node.js.
DATABASE_SSL_REJECT_UNAUTHORIZED="false"

# Secret used to sign auth session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Base URL of the app (used for building absolute links, e.g. store URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# For a one-time local bootstrap only; set both in a secure shell, run
# `npm run admin:bootstrap`, then remove them from the environment.
# Public signup never grants platform roles.
