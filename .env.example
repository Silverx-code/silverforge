# PostgreSQL connection strings
# For connection poolers (PgBouncer, Supabase Supavisor, Neon, AWS RDS Proxy),
# append `?pgbouncer=true&statement_cache_size=0` to disable prepared statement caching.
DATABASE_URL="postgresql://postgres:password@localhost:6543/silverforge?pgbouncer=true&statement_cache_size=0"

# Secret used to sign auth session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Base URL of the app (used for building absolute links, e.g. store URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
